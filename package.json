{
  "name": "oc-flight-deck",
  "version": "0.2.0",
  "description": "Live OpenCode V2 session telemetry — agent, model, branch, cost, tokens, cache hit rate and context usage in your sidebar.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "tui",
    "cli",
    "sidebar",
    "telemetry",
    "cost"
  ],
  "license": "MIT",
  "author": "nathwn12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathwn12/oc-flight-deck.git"
  },
  "homepage": "https://github.com/nathwn12/oc-flight-deck#readme",
  "bugs": {
    "url": "https://github.com/nathwn12/oc-flight-deck/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tui": {
      "types": "./src/tui/index.tsx",
      "import": "./src/tui/index.tsx"
    }
  },
  "files": [
    "src",
    "flight-deck.example.jsonc",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "0.0.0-beta-19425"
  },
  "devDependencies": {
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "@types/bun": "^1.4.2",
    "solid-js": "1.9.15",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  }
}
