{
  "$schema": "./flight-deck.schema.json",

  // ═════════════════════════════════════════════════════════════════════════
  //  ✈  Flight Deck — configuration
  //
  //  EVERYTHING HERE IS OPTIONAL. Install the plugin and the panel works with
  //  no config file at all. The values below are the defaults, written out so
  //  you can see exactly what there is to change. Delete any key and its
  //  default comes straight back.
  //
  //  TO USE IT: copy this file to `flight-deck.jsonc` at your project root, or
  //  to `.opencode/flight-deck.jsonc`. Comments and trailing commas are fine.
  //
  //  Flight Deck looks in this order and uses the first file it finds:
  //    .opencode/flight-deck.jsonc   .opencode/flight-deck.json
  //    flight-deck.jsonc             flight-deck.json
  //
  //  The same values can also be passed as plugin options in opencode.jsonc /
  //  cli.json, which take precedence on hosts that forward them.
  // ═════════════════════════════════════════════════════════════════════════

  // ── Update cadence ───────────────────────────────────────────────────────
  // Milliseconds between refreshes: the tick rate of everything that has to
  // animate. The status spinner has ten frames, so 100 turns it once a second.
  //
  // Cost, tokens, and permissions arrive from the host's own events, so they
  // stay current with no timer at all. Only clock-derived rows need one — and
  // `elapsed` plus the spinner are the reason this exists. Without a tick they
  // would sit frozen between turns.
  //
  //    100  default — the spinner turns once a second, the clock stays live
  //     50  twice as lively, still negligible work per tick
  //   1000  a calm wall-clock tick, but the spinner visibly stutters
  //      0  no timer; `elapsed` and the spinner only move when the session does
  //
  // Anything faster than 16 (one frame at 60Hz) is clamped: a tick wakes the
  // host's renderer, so a smaller value spends work without adding motion.
  "refresh": 100,

  // ── Sidebar ──────────────────────────────────────────────────────────────
  "sidebar": {
    // false hides the whole panel.
    "enabled": true,

    // Fixed lines, rendered above the live rows. This is the only text Flight
    // Deck shows of its own — put your own words here, or a rule.
    // The first line uses your theme's primary text colour; the rest use the
    // subdued colour.
    "lines": ["✈ FLIGHT DECK", "─────────────────"],

    // The live rows, top to bottom. Every value is read from the open session,
    // so you never type these in. Delete any row you don't want, or reorder
    // them freely — an unknown name is ignored with a one-time warning, so a
    // typo can never break the panel.
    //
    //   caution    the annunciator: silent unless something stopped moving
    //   status     running or idle — the glyph turns while anything is working
    //   agent      which agent is running (orchestrator, build, plan, ...)
    //   model      model id, plus the variant when there is one
    //   branch     current git branch
    //   cost       this conversation, plus its subagents when any ran; with
    //              `total` on the rail, the session figure alone
    //   total      the family total and subagent count on a row of its own
    //   project    every session in this project, not just the one on screen
    //   tokens     this session's input and output tokens
    //   cache      cache hit rate, then cache reads
    //   context    a gauge of how full the context window is
    //   perms      what is waiting for approval, not just how many
    //   elapsed    wall-clock time since the session started
    //   tps        output tokens per second on the last completed turn
    //   spark      recent turn sizes as a sparkline
    //   reasoning  reasoning tokens, when the model emits them
    //   turns      how many prompts you have sent this session
    //
    // A row appears only once the host has data for it — nothing is drawn as a
    // placeholder. The fixed lines and the live rows together are capped at 24,
    // and anything past that is dropped.
    "rows": [
      "caution",
      "status",
      "agent",
      "model",
      "branch",
      "cost",
      "project",
      "tokens",
      "cache",
      "context",
      "perms",
      "elapsed",
      "tps"
    ]
  },

  // ── Footer ───────────────────────────────────────────────────────────────
  // Off by default: the sidebar already carries the data, and the prompt
  // footer is high-traffic space, so a line there should earn its place.
  //
  // Writing ANY footer setting turns it on — `"footer": { "text": "hi" }` is
  // enough. Set "enabled": false explicitly to keep it hidden.
  "footer": {
    "enabled": false,
    // Any single line. Empty text is ignored.
    "text": "Flight Deck"
  },

  // -- Caution ---------------------------------------------------------------
  // The annunciator: a warning row for the one failure nothing else can see.
  //
  // A hang emits NO events - no completion, no error, nothing - so everything
  // observable about it is the absence of a signal. That is why this uses a
  // clock and a baseline instead of a listener.
  //
  // It is silent unless something has stopped moving, so it costs nothing on a
  // healthy session. When it speaks it reports what it saw, never what it
  // means: `shell running 8m41s`, not "stuck". A ten-minute build is not a hang.
  //
  // It never aborts, kills, retries or blocks anything. Read-only.
  "caution": {
    "enabled": true,

    // A tool running longer than this draws a subdued triangle...
    "toolWatchSeconds": 180,
    // ... and longer than this becomes a real caution.
    // Raised to match the watch value if you set it lower.
    "toolCautionSeconds": 420,

    // A running session that has produced nothing for this long is noted.
    // Deliberately generous: a large reasoning model can think for minutes
    // with nothing to show, which the clock cannot distinguish from a wedge.
    // Suppressed entirely while a tool or shell is running.
    "turnWatchSeconds": 600,
    "turnCautionSeconds": 1200,

    // Identical consecutive calls before it counts as a loop. Two is a retry.
    // Applies to identical successes and identical failures alike.
    "repeatThreshold": 3,

    // Tools that are slow by NATURE, so slow is not an anomaly for them.
    // Matched by exact name.
    //
    // Calibrated against 54,218 real settled tool calls: at the default
    // threshold, 307 (0.57%) exceed it and 200 of those are these tools, so
    // with the list 0.20% of calls light the row. `subagent` alone crossed 152
    // times, with a p99 of 14.2 minutes. Without this list the annunciator
    // lights on every delegated task - which is how an alert gets ignored.
    // Add your own long-running or orchestration tools here.
    "exemptTools": ["question", "task", "subagent", "agent", "delegate", "delegate_many", "delegate_task"],

    // Also raise a toast, once per distinct problem, re-arming when the session
    // goes quiet. Off by default: the rail is the signal, a notification is an
    // interruption. Turn it on if you walk away from long runs.
    "toast": false
  },

  // -- Layout ----------------------------------------------------------------
  // Row geometry. Change these when your terminal is unusually narrow or wide.
  "layout": {
    // Width of the label column every row pads to. 10 fits "caution" plus a
    // space. Narrow it to fit more value on screen.
    "labelWidth": 10,
    // Cells in the `context` gauge.
    "barWidth": 10,
    // Samples drawn in the `spark` row. The newest turns are kept, so
    // narrowing this keeps the recent shape rather than the oldest. The row is
    // this many cells wide, so a large value is a wide row.
    "sparkWidth": 12
  },

  // -- Glyphs ----------------------------------------------------------------
  // The annunciator's characters. Change these if your terminal renders a
  // default as a box or at the wrong width - an ugly but readable panel beats
  // an unreadable one. One or two characters each.
  "glyphs": {
    "watch": "▲",
    "caution": "⚠",
    "clear": "○"
  }
}
